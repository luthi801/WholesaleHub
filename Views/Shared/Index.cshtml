@model WholesaleHub.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2>Dashboard Overview</h2>
    <div class="row text-center mt-4">
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Customers</h5>
                <p class="h3">@Model.TotalCustomers</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Total Sales Value</h5>
                <p class="h3">@Model.TotalSalesValue.ToString("C")</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Pending Deliveries</h5>
                <p class="h3">@Model.PendingDeliveries</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Outstanding Balance</h5>
                <p class="h3">@Model.OutstandingBalance.ToString("C")</p>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row">
        <div class="col-md-6">
            <h4>Recent Orders</h4>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td>@order.CustomerName</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td>@order.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-md-6">
            <h4>Low Stock Items</h4>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.LowStockProducts)
                    {
                        <tr>
                            <td>@product.ProductCode</td>
                            <td>@product.Name</td>
                            <td>@product.StockQuantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>