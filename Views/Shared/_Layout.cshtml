<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WholesaleHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body { background-color: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body:has(.sidebar) { margin-bottom: 0; }
        .sidebar { background-color: #0f172a; color: #fff; flex: 0 0 300px; min-height: 100vh; width: 300px; }
        .sidebar .nav-link { align-items: center; color: #94a3b8; display: flex; font-size: .9rem; margin: 2px 0; min-height: 42px; padding: .65rem 1rem; border-radius: 8px; font-weight: 500; transition: background-color .15s ease, color .15s ease; }
        .sidebar .nav-link i { color: #64748b; font-size: 1.05rem; width: 1.7rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #1e293b; color: #f8fafc; }
        .sidebar .nav-link:hover i, .sidebar .nav-link.active i { color: #38bdf8; }
        .sidebar-nav { min-height: 0; overflow-y: auto; }
        .sidebar-label { color: #64748b; font-size: .68rem; font-weight: 700; letter-spacing: .12em; margin: 1.25rem 1rem .5rem; text-transform: uppercase; }
        .sidebar-account { border-top: 1px solid rgba(148, 163, 184, .2); padding-top: 1rem; }
        .sidebar-account .min-width-0 { min-width: 0; }
        .sidebar-account-name { color: #f8fafc; font-size: .88rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .sidebar-account-role { color: #94a3b8; font-size: .74rem; }
        .sidebar-account .btn { align-items: center; border-color: rgba(148, 163, 184, .35); color: #cbd5e1; display: inline-flex; font-size: .86rem; gap: .45rem; justify-content: center; padding: .65rem .6rem; }
        .sidebar-account .btn:hover { background-color: #334155; border-color: #64748b; color: #fff; }
        .card-stat { border: none; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex">
            <aside class="sidebar d-flex flex-column p-3">
                <a href="/" class="d-flex align-items-center text-white text-decoration-none fs-4 fw-bold">
                    <i class="bi bi-box-seam me-2 text-info"></i> WholesaleHub
                </a>
                <hr class="text-secondary">
                <div class="sidebar-label">Workspace</div>
                <ul class="sidebar-nav nav nav-pills flex-column flex-grow-1">
                    <li class="nav-item"><a asp-controller="Dashboard" asp-action="Index" class="nav-link"><i class="bi bi-speedometer2 me-2"></i> Dashboard</a></li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Warehouse") || User.IsInRole("Customer"))
                    {
                        <li><a asp-controller="Products" asp-action="Index" class="nav-link"><i class="bi bi-box me-2"></i> Products</a></li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Warehouse"))
                    {
                        <li><a asp-controller="Inventory" asp-action="Index" class="nav-link"><i class="bi bi-warehouse me-2"></i> Inventory</a></li>
                        <li><a asp-controller="Suppliers" asp-action="Index" class="nav-link"><i class="bi bi-truck me-2"></i> Suppliers</a></li>
                        <li><a asp-controller="Purchasing" asp-action="Index" class="nav-link"><i class="bi bi-cart-plus me-2"></i> Purchasing</a></li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Accountant"))
                    {
                        <li><a asp-controller="Customers" asp-action="Index" class="nav-link"><i class="bi bi-people me-2"></i> Customers</a></li>
                        <li><a asp-controller="AccountsReceivable" asp-action="Index" class="nav-link"><i class="bi bi-cash-stack me-2"></i> Accounts Receivable</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="UserManagement" asp-action="Index" class="nav-link"><i class="bi bi-person-badge me-2"></i> User Accounts</a></li>
                    }
                    <li><a asp-controller="SalesOrders" asp-action="Index" class="nav-link"><i class="bi bi-receipt me-2"></i> @(User.IsInRole("Customer") ? "My Orders" : "Sales Orders")</a></li>
                    @if (User.IsInRole("Customer"))
                    {
                        <li><a asp-controller="Customers" asp-action="MyProfile" class="nav-link"><i class="bi bi-person me-2"></i> My Profile</a></li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Warehouse"))
                    {
                        <li><a asp-controller="Deliveries" asp-action="Index" class="nav-link"><i class="bi bi-geo-alt me-2"></i> Deliveries</a></li>
                    }
                    @if (!User.IsInRole("Customer"))
                    {
                        <li><a asp-controller="Crm" asp-action="Index" class="nav-link"><i class="bi bi-chat-dots me-2"></i> Customer CRM</a></li>
                        <li><a asp-controller="Reports" asp-action="Index" class="nav-link"><i class="bi bi-bar-chart me-2"></i> Reports</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="AuditLogs" asp-action="Index" class="nav-link"><i class="bi bi-shield-lock me-2"></i> Security Logs</a></li>
                    }
                </ul>
                <div class="sidebar-account mt-3">
                    <div class="d-flex align-items-center gap-2 min-width-0 mb-3">
                            <i class="bi bi-person-circle text-info fs-4"></i>
                            <div class="min-width-0">
                                <div class="sidebar-account-name">@User.Identity.Name</div>
                                <div class="sidebar-account-role">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value account</div>
                            </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-light w-100" title="Log out" aria-label="Log out"><i class="bi bi-box-arrow-right"></i><span>Logout</span></button>
                    </form>
                </div>
            </aside>
            <div class="w-100">
                <div class="p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <main class="auth-shell">
            @RenderBody()
        </main>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
