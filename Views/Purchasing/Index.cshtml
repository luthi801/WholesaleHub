@model IEnumerable<WholesaleHub.Models.PurchaseOrder>
@{
    ViewData["Title"] = "Purchasing Management";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">Purchase Orders</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-cart-plus"></i> New Purchase Order</a>
</div>

<div class="card border-0 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>PO ID</th>
                <th>Supplier</th>
                <th>Order Date</th>
                <th>Items Count</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var po in Model)
            {
                <tr>
                    <td>PO-#@po.PurchaseOrderID</td>
                    <td class="fw-bold">@po.Supplier?.SupplierName</td>
                    <td>@po.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@po.PurchaseOrderDetails.Count items</td>
                    <td>PHP @po.TotalAmount.ToString("N2")</td>
                    <td>
                        @if (po.Status == "Received") { <span class="badge bg-success">Received</span> }
                        else if (po.Status == "Pending") { <span class="badge bg-warning">Pending</span> }
                        else { <span class="badge bg-danger">Cancelled</span> }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@po.PurchaseOrderID" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
