@model WholesaleHub.ViewModels.CreatePurchaseOrderViewModel
@{
    ViewData["Title"] = "Create Purchase Order";
    var suppliers = ViewBag.Suppliers as List<WholesaleHub.Models.Supplier>;
    var products = ViewBag.Products as List<WholesaleHub.Models.Product>;
}
<h3 class="fw-bold mb-3">Create Purchase Order</h3>
<div class="card border-0 shadow-sm p-4 col-md-8">
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Select Supplier</label>
            <select asp-for="SupplierID" class="form-select" required>
                <option value="">-- Choose Supplier --</option>
                @foreach (var s in suppliers!)
                {
                    <option value="@s.SupplierID">@s.SupplierName</option>
                }
            </select>
        </div>

        <h5 class="fw-bold mt-4 mb-2">Order Line Items</h5>
        <div id="itemsContainer">
            <div class="row g-2 mb-2 item-row">
                <div class="col-md-5">
                    <select name="Items[0].ProductID" class="form-select" required>
                        <option value="">-- Select Product --</option>
                        @foreach (var p in products!)
                        {
                            <option value="@p.ProductID">@p.ProductName (@p.SKU)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="number" name="Items[0].Quantity" class="form-control" placeholder="Qty" min="1" required />
                </div>
                <div class="col-md-4">
                    <input type="number" step="0.01" name="Items[0].UnitCost" class="form-control" placeholder="Unit Cost (PHP)" required />
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Submit Purchase Order</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>