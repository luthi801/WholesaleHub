@model WholesaleHub.Models.CustomerPayment
@{
    ViewData["Title"] = "Receipt";
    var order = Model.SalesOrder ?? new WholesaleHub.Models.SalesOrder();
    var paymentStatusText = Model.PaymentStatus == "Paid" ? "PAID" : "UNPAID";
    var showPaid = Model.PaymentStatus == "Paid";
    var customerName = Model.Customer?.CompanyName ?? order.CustomerName;
}

<div class="receipt-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h3 class="fw-bold mb-0">Receipt</h3>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to payments</a>
        <a asp-action="DownloadReceipt" asp-route-id="@Model.PaymentID" class="btn btn-primary btn-sm">Download Receipt</a>
        <button type="button" onclick="window.print()" class="btn btn-outline-primary btn-sm">Print receipt</button>
    </div>
</div>

<div id="receipt-document" class="card border-0 shadow-sm p-4 mx-auto" style="max-width: 820px;">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
        <div>
            <div class="fw-bold fs-4">WholesaleHub</div>
            <div class="text-muted small">Buhangin, Davao City, Philippines</div>
            <div class="text-muted small">+63 917 123 4567 | sales@wholesalehub.ph</div>
        </div>
        <div class="text-end">
            <div class="fw-bold fs-5">Receipt #RCPT-@Model.PaymentID</div>
            <div class="text-muted small">Order #SO-#@order.SalesOrderID</div>
            <div class="text-muted small">Transaction #@Model.TransactionReference</div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="small text-muted text-uppercase fw-bold mb-1">Customer</div>
            <div>@customerName</div>
            <div>@(Model.Customer?.Email ?? "customer@wholesalehub.ph")</div>
            <div>@(Model.Customer?.Phone ?? "N/A")</div>
        </div>
        <div class="col-md-6 text-md-end">
            <div class="small text-muted text-uppercase fw-bold mb-1">Payment info</div>
            <div><strong>Order Date:</strong> @order.OrderDate.ToString("yyyy-MM-dd")</div>
            <div><strong>Payment Date:</strong> @Model.PaymentDate.ToString("yyyy-MM-dd")</div>
            <div><strong>Method:</strong> @Model.PaymentMethod</div>
            <div>
                <strong>Status:</strong>
                @if (showPaid)
                {
                    <span class="badge bg-success ms-1">PAID</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark ms-1">@paymentStatusText</span>
                }
            </div>
        </div>
    </div>

    <table class="table table-sm align-middle mb-3">
        <thead class="table-light">
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in order.SalesOrderDetails)
            {
                <tr>
                    <td>@item.Product?.ProductName</td>
                    <td>@item.QuantityOrdered</td>
                    <td>PHP @item.UnitPrice.ToString("N2")</td>
                    <td>PHP @item.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-end">
        <div style="min-width: 260px;">
            <div class="d-flex justify-content-between py-1"><span>Subtotal</span><span>PHP @order.TotalAmount.ToString("N2")</span></div>
            <div class="d-flex justify-content-between py-1"><span>Discount</span><span>PHP 0.00</span></div>
            <div class="d-flex justify-content-between py-1"><span>Delivery Fee</span><span>PHP 0.00</span></div>
            <hr />
            <div class="d-flex justify-content-between py-1 fw-bold"><span>Grand Total</span><span>PHP @order.TotalAmount.ToString("N2")</span></div>
            <div class="d-flex justify-content-between py-1"><span>Amount Paid</span><span>PHP @Model.AmountPaid.ToString("N2")</span></div>
            <div class="d-flex justify-content-between py-1"><span>Balance</span><span>PHP @((order.TotalAmount - Model.AmountPaid).ToString("N2"))</span></div>
        </div>
    </div>

    <div class="mt-4 pt-3 border-top text-center text-muted small">
        Thank you for choosing WholesaleHub.<br />
        This receipt is linked to order SO-#@order.SalesOrderID and payment reference @Model.TransactionReference.
    </div>
</div>

<style>
    @@media print {
        body { background: #fff !important; }
        body * { visibility: hidden; }
        #receipt-document, #receipt-document * { visibility: visible; }
        #receipt-document { position: absolute; left: 0; top: 0; width: 100%; }
        .receipt-toolbar { display: none !important; }
        .sidebar, .navbar, .topbar, .footer { display: none !important; }
    }
</style>
