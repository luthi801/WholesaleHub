@model IEnumerable<WholesaleHub.Models.User>
@{
    ViewData["Title"] = "User Accounts";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><h3 class="fw-bold mb-1">User Accounts</h3><div class="text-muted">Create and manage Accountant, Warehouse, and Customer access.</div></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Create Account</a>
</div>
<div class="card border-0 shadow-sm p-3 mb-3"><form method="get" class="row g-2"><div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or username" /></div><div class="col-md-3"><select name="role" class="form-select"><option value="">All managed roles</option><option value="Accountant" selected="@(ViewBag.Role == "Accountant")">Accountant</option><option value="Warehouse" selected="@(ViewBag.Role == "Warehouse")">Warehouse</option><option value="Customer" selected="@(ViewBag.Role == "Customer")">Customer</option></select></div><div class="col-md-2"><button class="btn btn-secondary w-100" type="submit"><i class="bi bi-search me-1"></i>Filter</button></div></form></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Name</th><th>Username</th><th>Role</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach (var user in Model) { <tr><td class="fw-bold">@user.Name</td><td>@user.UserName</td><td><span class="badge bg-primary">@user.Role</span></td><td>@user.CreatedAt.ToString("yyyy-MM-dd")</td><td><a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a></td></tr> }</tbody></table></div></div>