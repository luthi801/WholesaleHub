@model WholesaleHub.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Management Reports";
}
<h3 class="fw-bold mb-3">System Reports</h3>

<ul class="nav nav-tabs" id="reportTabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#inv">Inventory Report</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#sales">Sales Report</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#purchasing">Purchasing Report</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#ar">Financial (AR)</button></li>
</ul>

<div class="tab-content bg-white p-3 border border-top-0 rounded-bottom">
    <div class="tab-pane fade show active" id="inv">
        <h5 class="fw-bold my-2">Inventory Stock Snapshot</h5>
        <table class="table table-striped">
            <thead><tr><th>Product</th><th>On Hand</th><th>Reorder Level</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var i in Model.InventoryList)
                {
                    <tr><td>@i.Product?.ProductName</td><td>@i.QuantityOnHand</td><td>@i.ReorderLevel</td><td>@i.Status</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade" id="sales">
        <h5 class="fw-bold my-2">Sales Orders Summary</h5>
        <table class="table table-striped">
            <thead><tr><th>SO ID</th><th>Customer</th><th>Date</th><th>Amount</th></tr></thead>
            <tbody>
                @foreach (var s in Model.SalesList)
                {
                    <tr><td>SO-#@s.SalesOrderID</td><td>@s.Customer?.CompanyName</td><td>@s.OrderDate.ToShortDateString()</td><td>PHP @s.TotalAmount.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade" id="purchasing">
        <h5 class="fw-bold my-2">Purchase Orders Summary</h5>
        <table class="table table-striped">
            <thead><tr><th>PO ID</th><th>Supplier</th><th>Date</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var p in Model.PurchaseList)
                {
                    <tr><td>PO-#@p.PurchaseOrderID</td><td>@p.Supplier?.SupplierName</td><td>@p.OrderDate.ToShortDateString()</td><td>@p.Status</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="tab-pane fade" id="ar">
        <h5 class="fw-bold my-2">Financial Receivables</h5>
        <table class="table table-striped">
            <thead><tr><th>Customer</th><th>Total Billed</th><th>Paid</th><th>Balance</th></tr></thead>
            <tbody>
                @foreach (var a in Model.ARList)
                {
                    <tr><td>@a.Customer?.CompanyName</td><td>PHP @a.TotalAmount.ToString("N2")</td><td>PHP @a.AmountPaid.ToString("N2")</td><td>PHP @a.OutstandingBalance.ToString("N2")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

