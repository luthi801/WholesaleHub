@model WholesaleHub.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}
<h3 class="fw-bold mb-3">Edit Product</h3>
<div class="card border-0 shadow-sm p-4 col-md-6">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="ProductID" />
        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input asp-for="ProductName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <input asp-for="Category" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Unit Price (PHP)</label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Unit of Measure</label>
            <input asp-for="UnitOfMeasure" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Update Product</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>