@model WholesaleHub.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}
<h3 class="fw-bold mb-3">Edit Product</h3>
<div class="card border-0 shadow-sm p-4 col-md-6">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ProductID" />
        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input asp-for="ProductName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <input asp-for="Category" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Brand</label>
            <input asp-for="Brand" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Unit Price (PHP)</label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Unit of Measure</label>
            <input asp-for="UnitOfMeasure" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Minimum Order Quantity</label>
            <input asp-for="MinimumOrderQuantity" type="number" min="1" class="form-control" required />
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="mb-3"><img src="@Model.ImageUrl" alt="@Model.ProductName" style="width: 120px; height: 90px; object-fit: cover; border-radius: 8px;" /></div>
        }
        <div class="mb-3">
            <label class="form-label">Replace product image</label>
            <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        </div>
        <button type="submit" class="btn btn-primary">Update Product</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>