@model WholesaleHub.Models.Product
@{
    ViewData["Title"] = "Add Product";
}
<h3 class="fw-bold mb-3">Add New Product</h3>
<div class="card border-0 shadow-sm p-4 col-md-6">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input asp-for="ProductName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">SKU</label>
            <input asp-for="SKU" class="form-control" placeholder="BEV-0001" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Category</label>
            <input asp-for="Category" class="form-control" placeholder="Beverages / Grocery" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Brand</label>
            <input asp-for="Brand" class="form-control" placeholder="Brand name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Wholesale product description"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Unit Price (PHP)</label>
            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Unit of Measure</label>
            <input asp-for="UnitOfMeasure" class="form-control" placeholder="box / pack / bottle" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Minimum Order Quantity</label>
            <input asp-for="MinimumOrderQuantity" type="number" min="1" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Product image</label>
            <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
            <div class="form-text">JPG, PNG, or WEBP up to 5 MB.</div>
        </div>
        <button type="submit" class="btn btn-primary">Save Product</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>