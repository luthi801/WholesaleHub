@model WholesaleHub.ViewModels.CreateSalesOrderViewModel
@{
    ViewData["Title"] = "Place Order";
    var customers = ViewBag.Customers as List<WholesaleHub.Models.Customer> ?? new();
    var products = ViewBag.Products as List<WholesaleHub.Models.Product> ?? new();
}
<h3 class="fw-bold mb-3">@(User.IsInRole("Customer") ? "Products / Place Order" : "Create Sales Order")</h3>
<div class="card border-0 shadow-sm p-4 col-lg-10">
<form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
@if (!User.IsInRole("Customer")) { <div class="mb-3"><label class="form-label fw-bold">Customer</label><select asp-for="CustomerID" class="form-select" required><option value="">-- Select Customer --</option>@foreach (var customer in customers) { <option value="@customer.CustomerID">@customer.CompanyName</option> }</select></div> }
<h5 class="fw-bold mt-3">Review order</h5><div id="orderItems">
@for (var index = 0; index < Math.Max(Model.Items.Count, 1); index++)
{
    var selectedId = index < Model.Items.Count ? Model.Items[index].ProductID : 0;
    var quantity = index < Model.Items.Count && Model.Items[index].Quantity > 0 ? Model.Items[index].Quantity : 1;
    var selectedProduct = products.FirstOrDefault(product => product.ProductID == selectedId);
    <div class="row g-2 mb-2 order-item"><div class="col-md-6"><select name="Items[@index].ProductID" class="form-select product-select" required><option value="">-- Choose Product --</option>@foreach (var product in products) { <option value="@product.ProductID" data-price="@product.UnitPrice" data-stock="@product.Inventory?.QuantityOnHand" selected="@(product.ProductID == selectedId)">@product.ProductName (Available: @product.Inventory?.QuantityOnHand) - PHP @product.UnitPrice.ToString("N2")</option> }</select></div><div class="col-md-2"><input type="number" name="Items[@index].Quantity" value="@quantity" min="1" class="form-control quantity-input" required /></div><div class="col-md-3"><input type="text" value="PHP @(selectedProduct?.UnitPrice.ToString("N2") ?? "0.00")" class="form-control price-display" readonly /><input type="hidden" name="Items[@index].UnitPrice" value="@(selectedProduct?.UnitPrice ?? 0)" class="price-input" /></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-item"><i class="bi bi-trash"></i></button></div></div>
}
</div><button type="button" id="addItem" class="btn btn-outline-primary mb-3"><i class="bi bi-plus-circle me-1"></i>Add another product</button><div class="border-top pt-3 mb-3 text-end"><strong>Total: <span id="orderTotal">PHP 0.00</span></strong></div><button type="submit" class="btn btn-success"><i class="bi bi-check2-circle me-1"></i>Place Order</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form></div>
@section Scripts {<script>
let itemIndex=@Math.Max(Model.Items.Count,1); const products=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(products.Select(product=>new { id=product.ProductID,name=product.ProductName,price=product.UnitPrice,stock=product.Inventory?.QuantityOnHand??0 }))); const container=document.getElementById('orderItems'); const total=document.getElementById('orderTotal');
function updateTotal(){let value=0;document.querySelectorAll('.order-item').forEach(row=>value+=Number(row.querySelector('.price-input').value||0)*Number(row.querySelector('.quantity-input').value||0));total.textContent=`PHP ${value.toFixed(2)}`;}
function attach(row){row.querySelector('.product-select').addEventListener('change',()=>{const option=row.querySelector('.product-select').selectedOptions[0];const price=Number(option?.dataset.price||0);row.querySelector('.price-display').value=`PHP ${price.toFixed(2)}`;row.querySelector('.price-input').value=price;row.querySelector('.quantity-input').max=option?.dataset.stock||0;updateTotal();});row.querySelector('.quantity-input').addEventListener('input',updateTotal);row.querySelector('.remove-item').addEventListener('click',()=>{row.remove();updateTotal();});}
document.querySelectorAll('.order-item').forEach(attach);document.getElementById('addItem').addEventListener('click',()=>{const row=document.createElement('div');row.className='row g-2 mb-2 order-item';row.innerHTML=`<div class="col-md-6"><select name="Items[${itemIndex}].ProductID" class="form-select product-select" required><option value="">-- Choose Product --</option>${products.map(product=>`<option value="${product.id}" data-price="${product.price}" data-stock="${product.stock}">${product.name} (Available: ${product.stock}) - PHP ${Number(product.price).toFixed(2)}</option>`).join('')}</select></div><div class="col-md-2"><input type="number" name="Items[${itemIndex}].Quantity" value="1" min="1" class="form-control quantity-input" required></div><div class="col-md-3"><input type="text" value="PHP 0.00" class="form-control price-display" readonly><input type="hidden" name="Items[${itemIndex}].UnitPrice" value="0" class="price-input"></div><div class="col-md-1"><button type="button" class="btn btn-outline-danger remove-item"><i class="bi bi-trash"></i></button></div>`;container.appendChild(row);itemIndex++;attach(row);});updateTotal();
</script>}
