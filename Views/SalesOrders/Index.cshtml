@model IEnumerable<WholesaleHub.Models.SalesOrder>
@{
    var isCustomer = User.IsInRole("Customer");
    ViewData["Title"] = isCustomer ? "My Orders" : "Sales Orders";
    var currentOrders = Model.Where(order => order.OrderStatus != "Completed" && order.OrderStatus != "Cancelled").ToList();
    var historyOrders = Model.Where(order => order.OrderStatus == "Completed" || order.OrderStatus == "Cancelled").ToList();
}
<div class="d-flex justify-content-between align-items-center mb-3"><h3 class="fw-bold">@(isCustomer ? "My Orders" : "Sales Orders")</h3><a asp-action="Create" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i>Place New Order</a></div>
@if (isCustomer)
{
    <div class="card border-0 shadow-sm p-3 mb-4"><form method="get" class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label small">Status</label><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var value in new[] { "Pending Payment", "Payment Verification", "Paid", "Confirmed", "Processing", "Shipped", "Completed", "Cancelled" }) { <option value="@value" selected="@(ViewBag.Status == value)">@value</option> }</select></div><div class="col-md-3"><label class="form-label small">From date</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" /></div><div class="col-md-3"><label class="form-label small">To date</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" /></div><div class="col-md-2"><button type="submit" class="btn btn-secondary w-100"><i class="bi bi-funnel me-1"></i>Filter</button></div></form></div>
    <div class="row g-4"><div class="col-lg-6"><div class="card border-0 shadow-sm p-3 h-100"><h5 class="fw-bold mb-3">Current Orders</h5><partial name="_CustomerOrderTable" model="currentOrders" /></div></div><div class="col-lg-6"><div class="card border-0 shadow-sm p-3 h-100"><h5 class="fw-bold mb-3">Order History</h5><partial name="_CustomerOrderTable" model="historyOrders" /></div></div></div>
}
else
{
    <div class="card border-0 shadow-sm"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Order ID</th><th>Customer</th><th>Order Date</th><th>Total Amount</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>SO-#@order.SalesOrderID</td><td>@order.Customer?.CompanyName</td><td>@order.OrderDate.ToString("yyyy-MM-dd")</td><td>PHP @order.TotalAmount.ToString("N2")</td><td><span class="badge bg-info text-dark">@order.OrderStatus</span></td><td><a asp-action="Details" asp-route-id="@order.SalesOrderID" class="btn btn-sm btn-outline-info">Details</a></td></tr> }</tbody></table></div>
}