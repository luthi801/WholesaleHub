@model WholesaleHub.Models.SalesOrder
@{
    ViewData["Title"] = "Sales Order Details";
}

<div class="receipt-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h3 class="fw-bold mb-0">Sales Order Details #@Model.SalesOrderID</h3>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="printReceipt(false)"><i class="bi bi-printer me-1"></i> Print receipt</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="printReceipt(true)"><i class="bi bi-archive me-1"></i> Print archive copy</button>
    </div>
</div>

<div id="receiptDocument" class="receipt-document">
    <div class="archive-only text-center fw-bold mb-3">ARCHIVE COPY</div>
    <div class="row g-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3">
            <h5 class="fw-bold">Summary</h5>
            <p class="mb-1"><strong>Customer:</strong> @Model.Customer?.CompanyName</p>
            <p class="mb-1"><strong>Status:</strong> @Model.OrderStatus</p>
            <p class="mb-1"><strong>Tracking #:</strong> @Model.Deliveries.FirstOrDefault()?.TrackingNumber</p>
            <p class="mb-0"><strong>AR Status:</strong> @Model.AccountsReceivable?.PaymentStatus</p>
            @if (User.IsInRole("Customer") && (Model.OrderStatus == "Pending Payment" || Model.OrderStatus == "Payment Verification"))
            {
                <div class="mt-3">
                    <a asp-controller="Payments" asp-action="Checkout" asp-route-id="@Model.SalesOrderID" class="btn btn-success w-100">Proceed to checkout</a>
                </div>
            }
            @if (!User.IsInRole("Customer") && Model.OrderStatus != "Completed" && Model.OrderStatus != "Cancelled")
            {
                var nextStatuses = Model.OrderStatus switch
                {
                    "Pending Payment" => new[] { "Payment Submitted", "Cancelled" },
                    "Payment Submitted" => new[] { "Payment Verification", "Cancelled" },
                    "Payment Verification" => new[] { "Paid", "Rejected", "Cancelled" },
                    "Paid" => new[] { "Confirmed", "Cancelled" },
                    "Confirmed" => new[] { "Processing", "Cancelled" },
                    "Processing" => new[] { "Shipped", "Cancelled" },
                    "Shipped" => new[] { "Completed" },
                    _ => Array.Empty<string>()
                };
                <form asp-action="UpdateStatus" method="post" class="mt-3">
                    <input type="hidden" name="id" value="@Model.SalesOrderID" />
                    <label class="form-label small fw-bold">Update status</label>
                    <div class="input-group"><select name="status" class="form-select">@foreach (var nextStatus in nextStatuses) { <option value="@nextStatus">@nextStatus</option> }</select><button type="submit" class="btn btn-primary">Update</button></div>
                </form>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Unit Price</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SalesOrderDetails)
                    {
                        <tr>
                            <td><div class="d-flex align-items-center gap-2">@if (!string.IsNullOrWhiteSpace(d.Product?.ImageUrl)) { <img src="@d.Product.ImageUrl" alt="@d.Product.ProductName" style="width: 48px; height: 38px; object-fit: cover; border-radius: 6px;" /> } else { <i class="bi bi-image text-secondary"></i> }<span>@d.Product?.ProductName</span></div></td>
                            <td>@d.QuantityOrdered</td>
                            <td>PHP @d.UnitPrice.ToString("N2")</td>
                            <td>PHP @d.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </div>
</div>

@section Styles {
    <style>
        .archive-only { display: none; }
        @@media print {
            body { background: #fff !important; margin: 0 !important; }
            body * { visibility: hidden; }
            #receiptDocument, #receiptDocument * { visibility: visible; }
            #receiptDocument { left: 0; position: absolute; top: 0; width: 100%; }
            .receipt-toolbar { display: none !important; }
            body.archive-copy .archive-only { display: block; }
        }
    </style>
}

@section Scripts {
    <script>
        function printReceipt(isArchiveCopy) {
            document.body.classList.toggle("archive-copy", isArchiveCopy);
            window.print();
        }

        window.addEventListener("afterprint", function () {
            document.body.classList.remove("archive-copy");
        });
    </script>
}
