@model IEnumerable<WholesaleHub.Models.SalesOrder>
<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Order number</th><th>Order date</th><th>Total amount</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var order in Model) { <tr><td>SO-#@order.SalesOrderID</td><td>@order.OrderDate.ToString("yyyy-MM-dd")</td><td>PHP @order.TotalAmount.ToString("N2")</td><td><span class="badge @(order.OrderStatus == "Paid" || order.OrderStatus == "Confirmed" ? "bg-success" : order.OrderStatus == "Rejected" ? "bg-danger" : "bg-info text-dark")">@order.OrderStatus</span></td><td><div class="d-flex gap-2"><a asp-action="Details" asp-route-id="@order.SalesOrderID" class="btn btn-sm btn-outline-info">Details</a>@if (order.OrderStatus == "Pending Payment" || order.OrderStatus == "Payment Verification") { <a asp-controller="Payments" asp-action="Checkout" asp-route-id="@order.SalesOrderID" class="btn btn-sm btn-success">Checkout</a> }</div></td></tr> }</tbody></table></div>